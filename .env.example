PUBLIC_REPO_SLUG=ArtemioPadilla/JustSplit
PUBLIC_BUILD_SHA=dev
PUBLIC_VERSION=dev

# Supabase public config (plan B2a). Both values are browser-public by design:
# authorization is Postgres RLS, never the client. Leave both empty to run the
# guarded `supabaseEnabled === false` path (what ci.yml builds).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=

# `true` defaults the URL to `supabase start` (http://127.0.0.1:54321); the key
# still comes from PUBLIC_SUPABASE_KEY (the local anon key printed by
# `npx supabase status`). Ignored in production builds.
PUBLIC_SUPABASE_LOCAL=true
