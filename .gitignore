# Environment secrets — never commit real secrets
.env
.env.*
# …but the committed example file must NOT be ignored (it carries no secrets)
!.env.example

# Build outputs
node_modules/
dist/
dist-offline/
.astro/
.cache/

# Logs
*.log
logs/

# Test / CI artifacts
test-results/
playwright-report/
.lighthouseci/
coverage/
.nyc_output

# Vendored @cyber-eco tarballs are committed on purpose (B2a); everything else
# under vendor/ is not
vendor/*
!vendor/*.tgz
!vendor/README.md

# OS / editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# NOTE: the pre-migration Python/Next ignore list (which hid `lib/` and with it
# the whole `src/lib/` tree — see PR #14) was retired in B1.

# Jest-era HTML reports
reports/
