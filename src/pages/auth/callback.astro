---
import { SITE } from '@/lib/site-meta';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthCallbackIsland from '../../components/islands/AuthCallbackIsland';
---

<BaseLayout title={`Signing you in — ${SITE.name}`} description="Completing sign-in." noindex>
  <main id="main-content" class="mx-auto flex min-h-[70vh] max-w-md flex-col items-center justify-center px-4 py-12">
    <div class="w-full">
      <AuthCallbackIsland client:only="react">
        <div slot="fallback" class="h-24 w-full animate-pulse rounded-md bg-muted" aria-busy="true">
          <noscript>
            <p class="p-4 text-sm text-muted-foreground">JustSplit needs JavaScript to finish signing you in.</p>
          </noscript>
        </div>
      </AuthCallbackIsland>
    </div>
  </main>
</BaseLayout>
