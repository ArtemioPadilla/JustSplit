---
import { withBase } from '@/lib/href';
import { SITE } from '@/lib/site-meta';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResetPasswordIsland from '../../components/islands/ResetPasswordIsland';
---

<BaseLayout title={`Reset password — ${SITE.name}`} description={`Reset your ${SITE.name} password.`} noindex>
  <main id="main-content" class="mx-auto flex min-h-[70vh] max-w-md flex-col items-center justify-center px-4 py-12">
    <div class="w-full space-y-6">
      <header class="text-center">
        <a
          href={withBase('/')}
          class="inline-flex items-center gap-2 font-display text-lg font-semibold tracking-tight text-foreground"
          aria-label={`${SITE.name} — home`}
        >
          {SITE.name}
        </a>
      </header>

      <div class="rounded-xl border border-border bg-card p-6 shadow-sm">
        <ResetPasswordIsland client:only="react">
          <div slot="fallback" class="space-y-4" aria-busy="true">
            <div class="h-6 w-1/2 animate-pulse rounded bg-muted"></div>
            <div class="h-9 w-full animate-pulse rounded bg-muted"></div>
            <div class="h-9 w-full animate-pulse rounded bg-muted"></div>
            <noscript>
              <p class="text-sm text-muted-foreground">JustSplit needs JavaScript to reset your password.</p>
            </noscript>
          </div>
        </ResetPasswordIsland>
      </div>
    </div>
  </main>
</BaseLayout>
