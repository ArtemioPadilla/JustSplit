---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppRouterIsland from '../components/islands/AppRouterIsland';
import { withBase } from '../lib/href';

// The app shell for client-only dynamic routes (spec D2, plan B2c). GitHub
// Pages serves dist/404.html for every URL without a prerendered page, so
// /expenses/<id>, /events/edit/<id>, /groups/<id>, /friends/<id>, … land
// here and AppRouterIsland mounts the matching route island by pathname, or
// the not-found view. The HTTP status stays 404; these are authenticated
// routes that crawlers must not index.
---

<BaseLayout title="JustSplit" description="Fair expense splitting made simple." noindex>
  <AppRouterIsland client:only="react">
    <div slot="fallback" class="mx-auto flex max-w-3xl flex-col px-4 py-24" aria-busy="true">
      <div class="h-4 w-24 animate-pulse rounded bg-muted"></div>
      <div class="mt-4 h-9 w-2/3 animate-pulse rounded bg-muted"></div>
      <div class="mt-6 h-4 w-full max-w-prose animate-pulse rounded bg-muted"></div>
      <noscript>
        <h1 class="mt-8 font-display text-3xl font-semibold text-foreground">This page needs JavaScript</h1>
        <p class="mt-4 text-muted-foreground">
          JustSplit runs in the browser. Enable JavaScript, or go
          <a class="underline" href={withBase('/')}>back home</a>.
        </p>
      </noscript>
    </div>
  </AppRouterIsland>
</BaseLayout>
