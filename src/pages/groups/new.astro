---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupFormIsland from '../../components/islands/GroupFormIsland';
import { withBase } from '../../lib/href';

// `/groups/new`'s shell (plan B12), same pattern as `/expenses/new.astro`:
// a static skeleton renders until GroupFormIsland hydrates and either
// mounts the real create form or redirects a signed-out visitor to
// /landing/ (AuthGate, plan B4).
---

<BaseLayout title="New group · JustSplit" description="Create a group and add members from your accepted friends.">
  <main id="main-content">
    <GroupFormIsland client:only="react">
      <div slot="fallback" class="mx-auto flex max-w-3xl flex-col gap-4 px-4 py-10" aria-busy="true">
        <div class="h-10 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-64 w-full animate-pulse rounded bg-muted"></div>
        <noscript>
          <h1 class="mt-8 font-display text-3xl font-semibold text-foreground">This page needs JavaScript</h1>
          <p class="mt-4 text-muted-foreground">
            JustSplit runs in the browser. Enable JavaScript, or go
            <a class="underline" href={withBase('/landing/')}>learn more about JustSplit</a>.
          </p>
        </noscript>
      </div>
    </GroupFormIsland>
  </main>
</BaseLayout>
