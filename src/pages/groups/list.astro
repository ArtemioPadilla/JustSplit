---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupsListIsland from '../../components/islands/GroupsListIsland';
import { withBase } from '../../lib/href';

// The groups list shell (plan B12), same pattern as expenses/list.astro's:
// a static skeleton renders until GroupsListIsland hydrates and either
// mounts the real list or redirects a signed-out visitor to /landing/
// (AuthGate, plan B4).
---

<BaseLayout title="Groups · JustSplit" description="Every group you're a member of, with member counts and a link to create a new one.">
  <main id="main-content">
    <GroupsListIsland client:only="react">
      <div slot="fallback" class="mx-auto flex max-w-3xl flex-col gap-4 px-4 py-10" aria-busy="true">
        <div class="h-10 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-64 w-full animate-pulse rounded bg-muted"></div>
        <noscript>
          <h1 class="mt-8 font-display text-3xl font-semibold text-foreground">This page needs JavaScript</h1>
          <p class="mt-4 text-muted-foreground">
            JustSplit runs in the browser. Enable JavaScript, or go
            <a class="underline" href={withBase('/landing/')}>learn more about JustSplit</a>.
          </p>
        </noscript>
      </div>
    </GroupsListIsland>
  </main>
</BaseLayout>
