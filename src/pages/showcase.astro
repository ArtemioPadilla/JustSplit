---
import BaseLayout from '../layouts/BaseLayout.astro';
import UserMenuIsland from '@/components/islands/UserMenuIsland';
import ShowcaseCurrencySelector from '@/components/islands/ShowcaseCurrencySelector';
import CurrencyExchangeTicker from '@/components/islands/CurrencyExchangeTicker';
import ShowcaseEditable from '@/components/islands/ShowcaseEditable';
import ShowcaseExportCsvButton from '@/components/islands/ShowcaseExportCsvButton';
import ShowcaseDashboardCharts from '@/components/islands/ShowcaseDashboardCharts';
import ShowcaseEventTimeline from '@/components/islands/ShowcaseEventTimeline';
import ShowcaseResetLocalDataButton from '@/components/islands/ShowcaseResetLocalDataButton';
import ShowcaseTabs from '@/components/islands/ShowcaseTabs';
import { ProgressBar } from '@/components/ui/progress-bar';
// /showcase — every reusable widget JustSplit ships must appear here
// (CLAUDE.md quality bar). Track B islands add their widgets as they land.
---

<BaseLayout title="Showcase — JustSplit" description="Every reusable widget, rendered live in light and dark.">
  <main id="main-content" class="mx-auto max-w-5xl px-5 py-16 [&_code]:[overflow-wrap:anywhere]">
    <h1 class="font-display text-3xl font-semibold tracking-tight">Showcase</h1>
    <p class="mt-2 text-muted-foreground">Reusable widgets, one section each.</p>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">UserMenuIsland <span class="text-sm font-normal text-muted-foreground">(B6)</span></h2>
      <p class="text-sm text-muted-foreground">
        Layout island mounted in SiteHeader on every page. Reads $user/$profile/$authReady
        (src/stores/auth.ts) only — no session is bootstrapped on this page, so it renders
        its signed-out state below (a Sign in link), which is also exactly what it renders
        when Supabase isn't configured for the build.
      </p>
      <div class="inline-flex rounded-md border border-border bg-card p-3">
        <UserMenuIsland client:idle />
      </div>
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">CurrencySelector <span class="text-sm font-normal text-muted-foreground">(B16)</span></h2>
      <p class="text-sm text-muted-foreground">
        Base UI <code>Combobox</code> (combobox.tsx) extended to accept
        {'{code,symbol,name}'} items with a <code>renderItem</code>, over
        SUPPORTED_CURRENCIES (domain/currency.ts). Fully controlled — this
        wrapper island holds the value/onChange state for the demo.
      </p>
      <div class="max-w-xs rounded-md border border-border bg-card p-3">
        <ShowcaseCurrencySelector client:idle />
      </div>
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">CurrencyExchangeTicker <span class="text-sm font-normal text-muted-foreground">(B16)</span></h2>
      <p class="text-sm text-muted-foreground">
        Reads $preferredCurrency (defaults to USD here — no session is
        bootstrapped on this page) and fetchExchangeRate
        (src/lib/currency/rates.ts, over $rateCache) for every other
        supported currency. Refreshes every 30 minutes; hydrates only once
        scrolled into view.
      </p>
      <CurrencyExchangeTicker client:visible />
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">Editable <span class="text-sm font-normal text-muted-foreground">(B16)</span></h2>
      <p class="text-sm text-muted-foreground">
        Inline click-to-edit text (editable.tsx, @zag-js/editable) — replaces
        the legacy <code>EditableText</code> in expense/event/group detail.
        Enter saves, Escape cancels, blur saves, an empty commit is rejected
        and reverts to the previous value.
      </p>
      <div class="max-w-sm rounded-md border border-border bg-card p-3">
        <ShowcaseEditable client:idle />
      </div>
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">ProgressBar <span class="text-sm font-normal text-muted-foreground">(B16)</span></h2>
      <p class="text-sm text-muted-foreground">
        Purely presentational (progress-bar.tsx) — no interactivity, so no
        <code>client:*</code> directive: it renders as static HTML, shipping
        zero JS.
      </p>
      <div class="max-w-sm rounded-md border border-border bg-card p-3">
        <ProgressBar value={62} label="Event settlement progress" />
      </div>
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">ExportCsvButton <span class="text-sm font-normal text-muted-foreground">(B17a)</span></h2>
      <p class="text-sm text-muted-foreground">
        Wraps download-trigger.tsx around domain/csvExport.ts#expensesToCSV — data-source-agnostic
        (props expenses/users/events/filename), so a real mount site (B8b/B9/B11b) resolves
        <code>users</code> from <code>useProfiles</code>. Demoed here over two fictional in-memory
        expenses. The exported CSV is a UTF-8-BOM-prefixed Blob (Excel renders accented names
        correctly) and defangs any cell that looks like a spreadsheet formula.
      </p>
      <div class="inline-flex rounded-md border border-border bg-card p-3">
        <ShowcaseExportCsvButton client:idle />
      </div>
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">Dashboard charts <span class="text-sm font-normal text-muted-foreground">(B8a)</span></h2>
      <p class="text-sm text-muted-foreground">
        MonthlyTrendsChart/ExpenseDistribution (Recharts, <code>ui/charts/bar-chart.tsx</code> +
        <code>ui/charts/donut-chart.tsx</code>) and BalanceOverview/BalanceLine (an accessible CSS
        bar — see BalanceLine.tsx for why) over fictional in-memory expenses, run through the real
        <code>domain/dashboard.ts</code> selectors. Recharts loads through <code>React.lazy</code>
        (<code>DashboardCharts.lazy.tsx</code>), so it never lands in this page's static JS —
        <code>scripts/check-charts-bundle.mjs</code> asserts that at the built-HTML level.
      </p>
      <div class="rounded-md border border-border bg-card p-4">
        <ShowcaseDashboardCharts client:visible />
      </div>
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">EventTimeline <span class="text-sm font-normal text-muted-foreground">(B11a)</span></h2>
      <p class="text-sm text-muted-foreground">
        Percentage-positioned expense/event timeline (<code>features/events/EventTimeline.tsx</code>) over
        a fictional 8-day trip. Markers open an Inceptor <code>ui/hover-card.tsx</code> (Base UI) on hover
        <em>and</em> keyboard focus; every expense is also listed in a permanently-present
        <code>sr-only</code> list below the visible track, so nothing here is reachable by hover alone.
        Settlement status and pre-/post-event placement are conveyed by text (aria-label + the legend),
        never marker color alone.
      </p>
      <div class="rounded-md border border-border bg-card p-4">
        <ShowcaseEventTimeline client:visible />
      </div>
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">Tabs <span class="text-sm font-normal text-muted-foreground">(A7)</span></h2>
      <p class="text-sm text-muted-foreground">
        Base UI <code>Tabs</code> (<code>ui/tabs.tsx</code>), the primitive behind /settlements. The
        selected tab is the raised, foreground-coloured pill: Base UI 1.0.0-rc.0 marks it
        <code>data-active</code> (not <code>data-selected</code>), which the styles key off — B14 fixed
        a version where every tab looked alike. Tabs, list, triggers and panels share state, so the
        whole composition is one island (<code>ShowcaseTabs.tsx</code>) hydrated once.
      </p>
      <div class="max-w-md rounded-md border border-border bg-card p-3">
        <ShowcaseTabs client:visible />
      </div>
    </section>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">Reset local data <span class="text-sm font-normal text-muted-foreground">(B17b)</span></h2>
      <p class="text-sm text-muted-foreground">
        "Restablecer datos locales" (<code>features/settings/ResetLocalDataButton.tsx</code>) —
        confirm-dialog wrapper over <code>lib/data/reset-local.ts#resetLocalData</code>: signs out,
        clears the idb-keyval Query persister and every <code>justsplit:*</code>/supabase-session
        localStorage key, unregisters service workers, then reloads. This is also the recovery
        action <code>QueryProvider</code> shows when the persister fails to restore. Confirming
        here performs the real reset — not a fictional demo.
      </p>
      <div class="inline-flex rounded-md border border-border bg-card p-3">
        <ShowcaseResetLocalDataButton client:idle />
      </div>
    </section>
  </main>
</BaseLayout>
