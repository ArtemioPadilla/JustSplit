---
import BaseLayout from '../layouts/BaseLayout.astro';
import UserMenuIsland from '@/components/islands/UserMenuIsland';
// /showcase — every reusable widget JustSplit ships must appear here
// (CLAUDE.md quality bar). Track B islands add their widgets as they land.
---

<BaseLayout title="Showcase — JustSplit" description="Every reusable widget, rendered live in light and dark.">
  <main class="mx-auto max-w-5xl px-5 py-16">
    <h1 class="font-display text-3xl font-semibold tracking-tight">Showcase</h1>
    <p class="mt-2 text-muted-foreground">Reusable widgets, one section each.</p>

    <section class="mt-10 space-y-3 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">UserMenuIsland <span class="text-sm font-normal text-muted-foreground">(B6)</span></h2>
      <p class="text-sm text-muted-foreground">
        Layout island mounted in SiteHeader on every page. Reads $user/$profile/$authReady
        (src/stores/auth.ts) only — no session is bootstrapped on this page, so it renders
        its signed-out state below (a Sign in link), which is also exactly what it renders
        when Supabase isn't configured for the build.
      </p>
      <div class="inline-flex rounded-md border border-border bg-card p-3">
        <UserMenuIsland client:idle />
      </div>
    </section>
  </main>
</BaseLayout>
