---
import BaseLayout from '../layouts/BaseLayout.astro';
import DashboardIsland from '../components/islands/DashboardIsland';
import { withBase } from '../lib/href';

// The dashboard shell (plan B8b): an authenticated route island, same
// pattern as the 404 app shell (plan B2c) — a static skeleton renders until
// DashboardIsland hydrates and either mounts the real dashboard or redirects
// a signed-out visitor to /landing/ (AuthGate, plan B4). Landing/marketing
// copy lives only in landing.astro (plan B7) — this page never duplicates it.
---

<BaseLayout title="Dashboard · JustSplit" description="Your expenses, events and balances at a glance.">
  <main id="main-content">
    <DashboardIsland client:only="react">
      <div slot="fallback" class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-10" aria-busy="true">
        <div class="h-10 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-24 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-48 w-full animate-pulse rounded bg-muted"></div>
        <noscript>
          <h1 class="mt-8 font-display text-3xl font-semibold text-foreground">This page needs JavaScript</h1>
          <p class="mt-4 text-muted-foreground">
            JustSplit runs in the browser. Enable JavaScript, or go
            <a class="underline" href={withBase('/landing/')}>learn more about JustSplit</a>.
          </p>
        </noscript>
      </div>
    </DashboardIsland>
  </main>
</BaseLayout>
