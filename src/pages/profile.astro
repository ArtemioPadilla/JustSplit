---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileIsland from '../components/islands/ProfileIsland';
import { withBase } from '../lib/href';

// `/profile`'s shell (plan B15), same pattern as `/groups/new.astro`: a
// static skeleton renders until ProfileIsland hydrates and either mounts
// the real profile/account content or redirects a signed-out visitor to
// /landing/ (AuthGate, plan B4).
---

<BaseLayout appNav title="Your profile · JustSplit" description="Edit your profile, avatar and preferred currency, and manage your account.">
  <main id="main-content">
    <ProfileIsland client:only="react">
      <div slot="fallback" class="mx-auto flex max-w-2xl flex-col gap-4 px-4 py-10" aria-busy="true">
        <div class="h-16 w-16 animate-pulse rounded-full bg-muted"></div>
        <div class="h-10 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-48 w-full animate-pulse rounded bg-muted"></div>
        <noscript>
          <h1 class="mt-8 font-display text-3xl font-semibold text-foreground">This page needs JavaScript</h1>
          <p class="mt-4 text-muted-foreground">
            JustSplit runs in the browser. Enable JavaScript, or go
            <a class="underline" href={withBase('/landing/')}>learn more about JustSplit</a>.
          </p>
        </noscript>
      </div>
    </ProfileIsland>
  </main>
</BaseLayout>
