---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExpenseFormIsland from '../../components/islands/ExpenseFormIsland';
import { withBase } from '../../lib/href';

// The new-expense shell (plan B10), same pattern as list.astro: a static
// skeleton renders until ExpenseFormIsland hydrates and either mounts the
// real form or redirects a signed-out visitor to /landing/ (AuthGate, B4).
---

<BaseLayout title="New expense · JustSplit" description="Add a new expense and split it with your group, event or friends.">
  <main id="main-content">
    <ExpenseFormIsland client:only="react">
      <div slot="fallback" class="mx-auto flex max-w-2xl flex-col gap-4 px-4 py-10" aria-busy="true">
        <div class="h-10 w-2/3 animate-pulse rounded bg-muted"></div>
        <div class="h-64 w-full animate-pulse rounded bg-muted"></div>
        <noscript>
          <h1 class="mt-8 font-display text-3xl font-semibold text-foreground">This page needs JavaScript</h1>
          <p class="mt-4 text-muted-foreground">
            JustSplit runs in the browser. Enable JavaScript, or go
            <a class="underline" href={withBase('/landing/')}>learn more about JustSplit</a>.
          </p>
        </noscript>
      </div>
    </ExpenseFormIsland>
  </main>
</BaseLayout>
