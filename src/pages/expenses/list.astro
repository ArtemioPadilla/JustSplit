---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExpenseListIsland from '../../components/islands/ExpenseListIsland';
import { withBase } from '../../lib/href';

// The expenses list shell (plan B9), same pattern as index.astro's
// dashboard shell: a static skeleton renders until ExpenseListIsland
// hydrates and either mounts the real list or redirects a signed-out
// visitor to /landing/ (AuthGate, plan B4).
---

<BaseLayout title="Expenses · JustSplit" description="Every expense you're part of, with a display-currency conversion and CSV export.">
  <main id="main-content">
    <ExpenseListIsland client:only="react">
      <div slot="fallback" class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-10" aria-busy="true">
        <div class="h-10 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-64 w-full animate-pulse rounded bg-muted"></div>
        <noscript>
          <h1 class="mt-8 font-display text-3xl font-semibold text-foreground">This page needs JavaScript</h1>
          <p class="mt-4 text-muted-foreground">
            JustSplit runs in the browser. Enable JavaScript, or go
            <a class="underline" href={withBase('/landing/')}>learn more about JustSplit</a>.
          </p>
        </noscript>
      </div>
    </ExpenseListIsland>
  </main>
</BaseLayout>
