---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventFormIsland from '../../components/islands/EventFormIsland';
import { withBase } from '../../lib/href';

// `/events/new`'s shell (plan B11b), same pattern as `/groups/new.astro`: a
// static skeleton renders until EventFormIsland hydrates and either mounts the
// real create form or redirects a signed-out visitor to /landing/ (AuthGate,
// plan B4). `?group=<id>` is read by the form itself.
---

<BaseLayout title="New event · JustSplit" description="Create an event, pick who is part of it from your friends, and track what it costs.">
  <main id="main-content">
    <EventFormIsland client:only="react">
      <div slot="fallback" class="mx-auto flex max-w-2xl flex-col gap-6 px-4 py-10" aria-busy="true">
        <div class="h-8 w-40 animate-pulse rounded bg-muted"></div>
        <div class="h-10 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-20 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-10 w-full animate-pulse rounded bg-muted"></div>
        <div class="h-32 w-full animate-pulse rounded bg-muted"></div>
        <noscript>
          <h1 class="mt-8 font-display text-3xl font-semibold text-foreground">This page needs JavaScript</h1>
          <p class="mt-4 text-muted-foreground">
            JustSplit runs in the browser. Enable JavaScript, or go
            <a class="underline" href={withBase('/landing/')}>learn more about JustSplit</a>.
          </p>
        </noscript>
      </div>
    </EventFormIsland>
  </main>
</BaseLayout>
