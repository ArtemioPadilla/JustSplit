---
import ThemeToggle from './ThemeToggle.astro';
import UserMenuIsland from '@/components/islands/UserMenuIsland';
import { withBase } from '@/lib/href';

interface Props {
  /**
   * Marketing pages (/landing, /about, /help — spec D3) never mount a route
   * island, so nothing on the page ever calls AuthBridge to populate
   * `$user` — it stays null for the page's whole lifetime. Hydrating
   * UserMenuIsland there to react to a change that can never happen is dead
   * weight: the shared @astrojs/react client runtime it needs to hydrate
   * anything is ~66 kB gz on its own (plan B7/B19 "Header weight"), which
   * alone blows the 40 kB marketing-page layout-JS budget. `static` renders
   * the exact same sign-in link markup UserMenuIsland's signed-out state
   * produces, with no island and no React at all.
   */
  static?: boolean;
}

const { static: staticHeader = false } = Astro.props;

// Expenses/Events/Groups/Friends/Settlements land through Phase 2 — adding
// them now would put dead links in the header on every page.
const nav: { href: string; label: string }[] = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/help', label: 'Help' },
];
---
<header class="sticky top-0 z-40 border-b border-border/60 bg-background/75 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center gap-3 px-5 py-2.5">
    <a href={withBase('/')} class="font-display text-lg font-semibold tracking-tight text-foreground">
      JustSplit
    </a>
    <div class="ml-auto flex items-center gap-1 font-mono text-xs sm:text-sm">
      {nav.map((n) => (
        <a href={withBase(n.href)} class="rounded-md px-2 py-1 text-muted-foreground transition-colors hover:text-primary">{n.label}</a>
      ))}
      {/* static (see Props above) skips the island entirely; otherwise the
          layout island (spec D3) reads $user/$profile/$authReady from
          src/stores/auth.ts only — never mounts AuthIsland/QueryProvider
          (src/tests/query-provider-boundary.test.ts). client:idle, never
          client:load (CLAUDE.md rule 3) or client:only (it needs to render
          server-side too — one of HydrationCanary's "SSR'd islands"). */}
      {staticHeader ? (
        <a
          href={withBase('/auth/signin/')}
          class="rounded-md px-2 py-1 text-muted-foreground transition-colors hover:text-primary"
        >
          Sign in
        </a>
      ) : (
        /* !static: hydrate the real island. */
        <UserMenuIsland client:idle />
      )}
      <span class="ml-1"><ThemeToggle /></span>
    </div>
  </nav>
</header>
