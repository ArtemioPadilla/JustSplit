---
import '../styles/global.css';
import FeedbackFAB from '../components/common/FeedbackFAB.astro';
import SiteHeader from '../components/common/SiteHeader.astro';
import SiteFooter from '../components/common/SiteFooter.astro';
import HydrationCanary from '../components/islands/HydrationCanary';
import ToasterIsland from '../components/islands/ToasterIsland';
import { withBase } from '../lib/href';
import { SITE } from '../lib/site-meta';
import { jsonLd } from '../lib/json-ld';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
  noindex?: boolean;
  /** Extra JSON-LD blocks (schema.org), appended after the default
   *  WebApplication block every page already gets. Each object is emitted
   *  as its own <script type="application/ld+json">, escaped via
   *  src/lib/json-ld.ts's jsonLd() (plain JSON.stringify is an XSS vector
   *  here — see that file's doc comment). */
  jsonLd?: Record<string, unknown>[];
  /**
   * /landing, /about, /help (plan B7, spec D3): plain marketing pages with
   * no route island and no @supabase/supabase-js / @cyber-eco/* chunk.
   * Passes `static` through to SiteHeader (a plain sign-in link, no
   * UserMenuIsland) and skips HydrationCanary — with zero hydrated React on
   * the page there is no hydration to mismatch, so the detector has nothing
   * to detect, and mounting it anyway would pull in the ~66 kB gz
   * @astrojs/react client runtime for no benefit (the 40 kB layout-JS
   * budget these pages must meet).
   */
  marketing?: boolean;
}

const {
  // Defaults come from src/lib/site-meta.ts (single source, also used by
  // /llms.txt) — a page that forgets these props must not introduce the
  // site as the Inceptor scaffold's generic placeholder strings.
  title = SITE.name,
  description = SITE.description,
  lang = 'en',
  noindex = false,
  jsonLd: extraJsonLd = [],
  marketing = false,
} = Astro.props;

// Canonical URL — Astro.site + the current path (falls back to null in dev
// without --site or a configured `site`). Feeds the JSON-LD "url" below.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;

// Every page is a JustSplit is the WebApplication schema.org describes
// itself as (plan B6) — expense-splitting software, not a document/article.
// Pages that need additional structured data (e.g. a future blog post's
// Article block) pass it through the `jsonLd` prop; it's appended, not
// replaced.
const jsonLdBlocks: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE.name,
    description: SITE.description,
    ...(canonicalUrl ? { url: canonicalUrl } : {}),
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
  },
  ...extraJsonLd,
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
      (function () {
        try {
          const s = localStorage.getItem('theme');
          const d = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (s === 'dark' || (s === null && d)) document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {/* JustSplit navy (plan B6) — matches --color-primary-600 in global.css. */}
    <meta name="theme-color" content="#124d8c" />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={jsonLd(block)} />
    ))}
  </head>
  <body class="relative min-h-screen bg-background text-foreground antialiased">
    <SiteHeader static={marketing} />
    <slot />
    <SiteFooter />
    <FeedbackFAB lang={lang} />
    {!marketing && (
      /* Side-effect-only island (renders null): listens for React hydration-
          mismatch signatures and stashes a pre-filled GitHub issue URL for
          FeedbackFAB to offer. Lives in BaseLayout only (CLAUDE.md "Island
          lifecycle discipline" exemplar) — client:idle like every other
          always-on-every-page layout island so it never blocks first paint.
          Skipped on `marketing` pages: no hydrated island runs there (spec
          D3), so there is no hydration to mismatch. */
      <HydrationCanary client:idle />
    )}
    {!marketing && (
      /* Single shared Toaster (plan B17b, ADR 0008) — every notifications.ts
         toast (success/error/"Report an issue") since B8b has had nowhere
         to render until this. `client:idle` like HydrationCanary: never
         competes with first paint. Skipped on `marketing` pages: they mount
         no route island and fire no toasts (spec D3), and
         check-auth-bundle.mjs's marketing-page check fails the build if any
         `<astro-island>` shows up there at all (the 40 kB layout-JS budget,
         plan B7) — this island's own @astrojs/react client runtime cost
         would blow that budget for zero benefit. */
      <ToasterIsland client:idle />
    )}
  </body>
</html>
