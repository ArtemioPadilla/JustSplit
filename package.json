{
  "name": "justsplit",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Fair expense splitting, made simple.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:astro": "astro check",
    "check:pragmas": "node scripts/check-ts-pragmas.mjs",
    "check": "npm-run-all --parallel check:astro type-check test lint check:pragmas --serial build check:dist check:auth-bundle",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "perf": "npm run build && lhci collect && lhci assert",
    "doctor": "bash scripts/doctor.sh",
    "monday": "bash scripts/monday.sh",
    "ship": "bash scripts/ship.sh",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:rls:mutation": "node scripts/rls-mutation-check.mjs",
    "test:contract:live": "vitest run --config vitest.contract.config.ts",
    "db:start": "supabase start -x studio,imgproxy,mailpit,edge-runtime,logflare,vector",
    "db:stop": "supabase stop",
    "db:migrate": "dbmate --no-dump-schema --migrations-dir db/migrations --url \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable}\" migrate",
    "db:rollback": "dbmate --no-dump-schema --migrations-dir db/migrations --url \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable}\" rollback",
    "db:status": "dbmate --no-dump-schema --migrations-dir db/migrations --url \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable}\" status",
    "db:seed": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -X -q -v ON_ERROR_STOP=1 -f supabase/seed.sql",
    "db:reset": "supabase db reset && npm run db:migrate && npm run db:seed",
    "db:audit": "bash scripts/db-audit.sh",
    "db:env": "node scripts/db-env.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:auth-bundle": "node scripts/check-auth-bundle.mjs",
    "check:a11y": "node scripts/axe-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^5.0.6",
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@cyber-eco/auth": "file:vendor/cyber-eco-auth-0.2.1.tgz",
    "@cyber-eco/supabase": "file:vendor/cyber-eco-supabase-0.2.1.tgz",
    "@cyber-eco/types": "file:vendor/cyber-eco-types-0.2.1.tgz",
    "@hookform/resolvers": "^5.4.0",
    "@nanostores/persistent": "^1.1.0",
    "@nanostores/react": "^1.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/query-persist-client-core": "^5.100.14",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "@zag-js/editable": "^1.43.0",
    "@zag-js/react": "^1.43.0",
    "astro": "^5.18.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "idb-keyval": "^6.2.4",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "nanostores": "^1.3.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-motion": "^1.1.1",
    "uuid": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.15.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vite-pwa/astro": "^1.2.0",
    "dbmate": "^2.36.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "playwright-core": "^1.63.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@cyber-eco/types": "$@cyber-eco/types"
  }
}
